<h1>Categoria: <%= categoria.nome %></h1>

<a href="/categorias">Voltar às categorias</a>

<h2>Produtos</h2>

<% if (produtos.length === 0) { %>
    <p>Esta categoria ainda não possui produtos.</p>
<% } else { %>
    <ul>
        <% produtos.forEach(produto => { %>
            <li><%= produto.nome %></li>
        <% }) %>
    </ul>
<% } %>
